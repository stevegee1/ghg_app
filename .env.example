# =============================================================================
# GHG Emissions Registered Trade Mark: Production Environment Configuration
# =============================================================================

# ── 1. Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/ghg_logodrop?schema=public"

# ── 2. Application & Networking ──────────────────────────────────────────────
PORT=3000
APP_BASE_URL="https://ghgapp-production.up.railway.app"
NODE_ENV="production"
JWT_SECRET="generate_a_secure_64_character_random_hex_string"

# ── 2b. Lead Auditor / Administrator Credentials ─────────────────────────────
# Set these on Railway so your admin account is seeded/updated on boot
ADMIN_EMAIL="admin@ghglogodrop.com"
ADMIN_PASSWORD="YourSecureAdminPassword123!"

# ── 3. Stripe Payments & Hosted Checkout ─────────────────────────────────────
# Test Mode prefix: sk_test_... / whsec_...
# Live Production prefix: sk_live_... / whsec_...
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PLATFORM_ACCOUNT_ID="acct_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ── 4. Polygon PoS ERC-1155 NFT Minting ───────────────────────────────────────
# Mainnet: network=mainnet, RPC=https://polygon-rpc.com
# Testnet: network=testnet, RPC=https://rpc-amoy.polygon.technology
POLYGON_NETWORK="mainnet"
POLYGON_RPC_URL="https://polygon-rpc.com"
POLYGON_CONTRACT_ADDRESS="0x..."
POLYGON_PRIVATE_KEY="0x..."

# ── 5. Email Notifications (Transactional & Password Reset) ───────────────────
# Supports Resend or SendGrid
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM="security@ghgemissionlogs.com"

# ── 6. Executive Demo Booking ─────────────────────────────────────────────────
DEMO_MEETING_URL="https://meet.google.com/xxx-xxxx-xxx"
