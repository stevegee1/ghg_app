# =============================================================================
# NFTYLOGS: Production Environment Configuration
# =============================================================================

# ── 1. Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/ghg_logodrop?schema=public"

# ── 2. Application & Networking ──────────────────────────────────────────────
PORT=3000
APP_BASE_URL="https://ghgapp-production.up.railway.app"
NODE_ENV="production"
JWT_SECRET="generate_a_secure_64_character_random_hex_string"

# ── 2b. Lead Auditor / Administrator Credentials ─────────────────────────────
# Set these on Railway so your admin account is seeded/updated on boot
ADMIN_EMAIL="admin@ghglogodrop.com"
ADMIN_PASSWORD="YourSecureAdminPassword123!"

# ── 3. Stripe Payments & Hosted Checkout ─────────────────────────────────────
# Test Mode prefix: sk_test_... / whsec_...
# Live Production prefix: sk_live_... / whsec_...
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PLATFORM_ACCOUNT_ID="acct_..."
# Stripe Price ID for the Fleet service: one asset per month (recurring, per-unit)
STRIPE_FLEET_PRICE_ID="price_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ── 4. Assurance Fees (one flat fee per client pipeline, in pence) ────────────
# GHG covers GHG and carbon frameworks; Workforce covers Section 106 and Social Value.
GHG_ASSURANCE_FEE_PENCE="125000"
WORKFORCE_ASSURANCE_FEE_PENCE="125000"
ASSURANCE_FEE_CURRENCY="GBP"

# ── 4b. AI Compliance Review (first provider with both key and model set is used) ─
# Each key requires its model name; the server refuses to start if a key is set without one.
# With no provider configured, submissions are pre-screened by the rules engine only.
GEMINI_API_KEY=""
GEMINI_MODEL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
OPENAI_API_KEY=""
OPENAI_MODEL=""

# ── 4c. Private File Storage (evidence files and client logos) ─────────────────
# Absolute path to a persistent, writable directory; on Railway, the mount path of a volume.
# The server refuses to start if it is missing. Files are never served publicly.
FILE_STORAGE_DIR=""

# ── 4d. Fleet Secrets ──────────────────────────────────────────────────────────
# Encrypts tracking-device secrets and client provider credentials at rest (AES-256-GCM).
# 32 bytes as 64 hex characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start without it. Changing it makes stored secrets unreadable.
FLEET_CREDENTIALS_KEY=""

# ── 5. Email Notifications (Transactional & Password Reset) ───────────────────
# Supports Resend or SendGrid
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM="security@ghgemissionlogs.com"

# ── 6. Executive Demo Booking ─────────────────────────────────────────────────
DEMO_MEETING_URL="https://meet.google.com/xxx-xxxx-xxx"

# Market inputs: GOV.UK Content API URL of the DESNZ "Weekly road fuel prices" publication.
# Leave unset to turn the automatic fuel price import off (values can still be entered by admins).
UK_FUEL_PRICE_FEED_URL="https://www.gov.uk/api/content/government/statistics/weekly-road-fuel-prices"

# Blockchain anchoring of record fingerprints (daily Merkle roots). Leave all unset to turn publishing off;
# set all of them to turn it on. Use Polygon Amoy (80002) for staging and Polygon PoS (137) in production.
# The wallet only needs a small MATIC/POL balance; it sends zero-value transactions to itself.
ANCHOR_RPC_URL=""
ANCHOR_PRIVATE_KEY=""
ANCHOR_CHAIN_ID=""
# Highest network fee per gas the publisher will pay, in gwei; above it publishing waits
ANCHOR_MAX_FEE_GWEI=""
ANCHOR_CONFIRMATIONS=""
# Block explorer transaction URL prefix, e.g. https://polygonscan.com/tx/ or https://amoy.polygonscan.com/tx/
ANCHOR_EXPLORER_TX_URL=""

# Weather exposure (Open-Meteo commercial historical API). Set both to turn it on, or neither to leave it off.
# Commercial endpoint, e.g. https://customer-archive-api.open-meteo.com/v1/archive
OPEN_METEO_ARCHIVE_URL=""
OPEN_METEO_API_KEY=""

