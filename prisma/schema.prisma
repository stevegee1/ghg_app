datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Licensee {
  id                       String               @id @default(cuid())
  name                     String
  vertical                 Vertical
  stripeConnectedAccountId String?
  royaltyBps               Int                  @default(1500)
  pricePerDropCents        Int?
  b2bApiKeyHash            String?
  isPubliclyVisible        Boolean              @default(false)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  transactions             Transaction[]
  portalUsers              PortalUser[]
  splitConfigs             SplitConfigHistory[]
  jobReports               JobCreationReport[]
  calibrationRecords       AssetCalibrationRecord[]
  telemetryLogs            TelemetryLog[]
  nonConformanceEvents     NonConformanceEvent[]
  auditReports             AuditInspectionReport[]
  evidenceDocuments        AuditEvidenceDocument[]
  isoReadinessSubmissions  IsoReadinessSubmission[]
  auditWarrantyCredentials AuditWarrantyCredential[]
  workflowSubmissions      WorkflowSubmission[]
  workflowApiKeys          WorkflowApiKey[]
}

enum Vertical {
  B2B_CLEAN_TECH
  B2B_HEAVY_MANUFACTURING
  B2C_SPORTS_MERCH
  B2C_LIFESTYLE_EVENTS
}

model Transaction {
  id                    String            @id @default(cuid())
  licenseeId            String
  licensee              Licensee          @relation(fields: [licenseeId], references: [id])
  checkoutReferenceId   String?           @unique
  grossAmountCents      Int
  currency              String            @default("GBP")
  status                TransactionStatus @default(PENDING)
  stripePaymentIntentId String?
  createdAt             DateTime          @default(now())

  triggerEvent          TriggerEvent?
  financialSplit        FinancialSplit?
  telemetryLog          TelemetryLog?
  customKeepsakeSpec    CustomKeepsakeSpec?
  souvenirOrder         SouvenirOrder?

  @@index([licenseeId])
}

enum TransactionStatus {
  PENDING
  SETTLED
  REFUNDED
  REVERSED
  FAILED
}

model TriggerEvent {
  id                 String             @id @default(cuid())
  transactionId      String             @unique
  transaction        Transaction        @relation(fields: [transactionId], references: [id])
  /// Describes data provenance (where a claim originated), NOT whether the claim has been independently verified.
  verificationSource VerificationSource
  attestationNote    String?
  deliveryType       DeliveryType
  fulfillmentStatus  FulfillmentStatus?
  weatherCondition   String?
  eventType          String?
  policyMilestoneRef String?
  rawPayload         Json?
  createdAt          DateTime           @default(now())
}

/// Describes the provenance of claim data submitted to the platform.
/// Note: These values indicate where data originated, NOT whether the underlying environmental/emissions claim has been independently audited or verified.
enum VerificationSource {
  THIRD_PARTY_API
  MANUAL_ATTESTATION
  CONSUMER_OPT_IN
}

enum DeliveryType {
  DIGITAL
  PHYSICAL
}

enum FulfillmentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum CharityStatus {
  PENDING_APPLICATION
  APPROVED_AWAITING_STRIPE
  ACTIVE
  EXPIRED
  PENDING
  INACTIVE
}

model Charity {
  id                       String              @id @default(cuid())
  name                     String
  stripeConnectedAccountId String?
  status                   CharityStatus       @default(ACTIVE)
  contractStartDate        DateTime?
  contractEndDate          DateTime?
  walletAddress            String?
  registeredCharityNumber  String?
  contactEmail             String?
  statement                String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @default(now()) @updatedAt

  allocations              CharityAllocation[]
}

model FinancialSplit {
  id                     String              @id @default(cuid())
  transactionId          String              @unique
  transaction            Transaction         @relation(fields: [transactionId], references: [id])
  licensorRoyaltyCents   Int
  charityGiftCents       Int
  stripeTransferId       String?
  charityStripeAccountId String?
  allocationsFinalized   Boolean             @default(false)
  settledAt              DateTime?
  createdAt              DateTime            @default(now())

  charityAllocations     CharityAllocation[]
}

model CharityAllocation {
  id               String         @id @default(cuid())
  financialSplitId String
  financialSplit   FinancialSplit @relation(fields: [financialSplitId], references: [id], onDelete: Cascade)
  charityId        String
  charity          Charity        @relation(fields: [charityId], references: [id])
  amountCents      Int
  stripeTransferId String?
  transferFailed   Boolean        @default(false)
  retryCount       Int            @default(0)
  createdAt        DateTime       @default(now())

  @@index([financialSplitId])
  @@index([charityId])
}

model PortalUser {
  id                     String               @id @default(cuid())
  email                  String               @unique
  passwordHash           String
  licenseeId             String?
  licensee               Licensee?            @relation(fields: [licenseeId], references: [id])
  role                   PortalRole           @default(PARTNER)
  passwordResetToken         String?              // SHA-256 hash of password reset token
  passwordResetExpiresAt     DateTime?            // Expiration timestamp for reset token
  emailVerified              Boolean              @default(false)
  emailVerificationToken     String?              // SHA-256 hash of email verification token
  emailVerificationExpiresAt DateTime?            // Expiration timestamp for verification token
  createdAt                  DateTime             @default(now())

  splitConfigs        SplitConfigHistory[]
  submittedJobReports JobCreationReport[]

  @@index([licenseeId])
  @@index([passwordResetToken])
  @@index([emailVerificationToken])
}

enum PortalRole {
  PARTNER
  ADMIN
}

model SplitConfigHistory {
  id                   String               @id @default(cuid())
  licenseeId           String?
  licensee             Licensee?            @relation(fields: [licenseeId], references: [id])
  royaltyBps           Int
  charityAllocationBps Json
  isActive             Boolean              @default(true)
  changedByUserId      String
  changedByUser        PortalUser           @relation(fields: [changedByUserId], references: [id])
  changedAt            DateTime             @default(now())
  previousConfigId     String?
  previousConfig       SplitConfigHistory?  @relation("ConfigHistoryChain", fields: [previousConfigId], references: [id])
  nextConfigs          SplitConfigHistory[] @relation("ConfigHistoryChain")

  @@index([licenseeId, isActive])
  @@index([changedByUserId])
}

enum PeriodType {
  QUARTERLY
  ANNUAL
}

enum ReportSource {
  MANUAL_ATTESTATION
  THIRD_PARTY_API
}

model JobCreationReport {
  id                String       @id @default(cuid())
  licenseeId        String
  licensee          Licensee     @relation(fields: [licenseeId], references: [id])
  periodType        PeriodType
  periodStart       DateTime
  periodEnd         DateTime
  jobsCreated       Int
  reportSource      ReportSource
  attestationNote   String
  submittedByUserId String?
  submittedByUser   PortalUser?  @relation(fields: [submittedByUserId], references: [id])
  createdAt         DateTime     @default(now())

  @@unique([licenseeId, periodType, periodStart, periodEnd])
  @@index([licenseeId])
}

enum SensorType {
  ELECTRICITY_SUB_METER
  WATER_FLOW_METER
  GAS_CHROMATOGRAPH
  THERMAL_FLOW_METER
  EMISSIONS_CEMS
}

enum MetricType {
  PUE
  WUE
  MWH_LOAD
  H2_PURITY_PCT
  THERMAL_KW
  CO2_PPM
}

/// GHG Protocol Corporate Standard scope classification (ISO 14064-1:2018 Clause 5.2)
enum GhgScope {
  SCOPE_1 // Direct emissions from owned/controlled sources
  SCOPE_2 // Indirect emissions from purchased energy
  SCOPE_3 // All other indirect value chain emissions
}

model AssetCalibrationRecord {
  id                String         @id @default(cuid())
  licenseeId        String
  licensee          Licensee       @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  assetTag          String         // e.g. "PDU-METER-04B", "ELECTROLYSER-SENS-01"
  sensorType        SensorType
  calibrationDate   DateTime
  expiryDate        DateTime
  certDocumentUrl   String         // URL/Path to certificate PDF
  certIntegrityHash String         // SHA-256 hash of certificate file
  isCurrentlyValid  Boolean        @default(true)
  verifiedBy        String?
  createdAt         DateTime       @default(now())

  telemetryLogs     TelemetryLog[]

  @@index([licenseeId, assetTag])
  @@index([expiryDate, isCurrentlyValid])
}

model TelemetryLog {
  id                       String                 @id @default(cuid())
  licenseeId               String
  licensee                 Licensee               @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  assetCalibrationId       String
  assetCalibration         AssetCalibrationRecord @relation(fields: [assetCalibrationId], references: [id])
  assetTag                 String
  metricType               MetricType
  numericValue             Float
  rawUnit                  String                 // e.g. "kW/h", "m3/h", "%", "ppm"
  ghgScope                 GhgScope?              // GHG Protocol Scope 1/2/3 classification
  activityAmount           Float?                 // Activity data quantity (fuel litres, kWh, km etc)
  unitOfMeasure            String?                // Activity data unit e.g. "litres", "kWh"
  emissionFactorKgCo2PerUnit Float?               // DEFRA/IPCC emission factor applied
  calculatedKgCo2e         Float?                 // Computed: activityAmount * emissionFactorKgCo2PerUnit
  isWithinBaseline         Boolean                @default(true)
  requiresSupervisor       Boolean                @default(false)
  rawTelemetryJson         Json?
  transactionId            String?                @unique
  transaction              Transaction?           @relation(fields: [transactionId], references: [id])
  createdAt                DateTime               @default(now())

  @@index([licenseeId, metricType])
  @@index([licenseeId, ghgScope])
  @@index([assetTag, createdAt])
}

enum ConformanceGrade {
  CONFORMANT
  OPPORTUNITY_FOR_IMPROVEMENT
  MINOR_NON_CONFORMANCE
  MAJOR_NON_CONFORMANCE_GREENWASHING_RISK
}

model NonConformanceEvent {
  id                 String           @id @default(cuid())
  licenseeId         String
  licensee           Licensee         @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  isoClause          String           // e.g. "ISO 50001:2018 Clause 9.1.1", "ISO 14001:2015 Clause 10.2"
  assetTag           String
  metricName         String           // "PUE", "WUE", "H2_PURITY_PCT"
  baselineValue      Float
  observedValue      Float
  percentageVariance Float
  conformanceGrade   ConformanceGrade @default(MINOR_NON_CONFORMANCE)
  rootCauseAnalysis  String?
  correctiveAction   String?
  assignedOwner      String?
  targetClosureDate  DateTime?
  isResolved         Boolean          @default(false)
  resolvedAt         DateTime?
  signOffSupervisor  String?
  createdAt          DateTime         @default(now())

  @@index([licenseeId, isResolved])
  @@index([assetTag, isResolved])
}

enum RiskLevel {
  LOW_RISK_CONFORMANT
  MEDIUM_RISK_OFI
  HIGH_RISK_GREENWASHING_EXPOSURE
}

model AuditInspectionReport {
  id                    String            @id @default(cuid())
  licenseeId            String
  licensee              Licensee          @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  auditRefId            String            @unique // e.g. "AR-2026-DH-01", "SC-2026-AUTO-01"
  facilityType          String            // "DATA_CENTRE", "GREEN_HYDROGEN_DRI", "COMMERCIAL_FLEET", "CLEANTECH_HARDWARE", "EVENT_MILESTONE"
  leadAuditorName       String            // e.g. "Lead Assurance Officer, GMC, LL.B."
  evaluationDate        DateTime
  weightedScore         Float             // 0.0 to 5.0
  overallGrade          ConformanceGrade
  greenwashingRiskLevel RiskLevel
  summaryNotes          String?
  createdAt             DateTime          @default(now())

  matrixRows            AuditMatrixRow[]
  evidenceDocuments     AuditEvidenceDocument[]

  @@index([licenseeId, facilityType])
}

model AuditMatrixRow {
  id                       String            @id @default(cuid())
  reportId                 String
  report                   AuditInspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  pillarIndex              Int               // 1 to 5
  pillarName               String            // e.g. "Power Usage Effectiveness", "Lithium-Ion Battery Integrity"
  isoClauseLink            String            // e.g. "ISO 50001:2018 Clause 9.1.1", "ISO 6469-1/-3"
  legalMandate             String            // e.g. "UK SECR / Companies Regs 2018", "EU Battery Regulation"
  targetDepartment         String            // e.g. "IT Infrastructure", "High-Voltage Engineering"
  questionText             String
  objectiveEvidenceTypes   String            // e.g. "SCADA Logs, Sub-Meter Calibration Certs"
  auditorFindings          String?
  scorePoints              Float             // 0.0 to 5.0 points
  complianceGrading        ConformanceGrade
  weight                   Float             // e.g. 0.25, 0.20, 0.15
  rootCause                String?
  mandatoryCorrectiveAction String?
  assignedOwner            String?
  targetClosureDate        DateTime?
  verifiedBy               String?
  verificationDate         DateTime?
  createdAt                DateTime          @default(now())

  @@index([reportId, pillarIndex])
}

model CustomKeepsakeSpec {
  id                String       @id @default(cuid())
  transactionId     String       @unique
  transaction       Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  garmentModel      String       // "HEAVYWEIGHT_HOODIE", "STRUCTURED_CAP", "SOFTSHELL_VEST"
  inscribedText     String       // e.g. "Bukayo Saka 89' Top-Corner Derby Winner"
  threadColor       String       // "GOLD_METALLIC", "STERLING_SILVER", "EMERALD_GREEN"
  placement         String       // "LEFT_CHEST", "RIGHT_SLEEVE", "BACK_COLLAR"
  artisanLaborHours Float        @default(1.5)
  lcaCarbonGrams    Int          @default(450)
  openSeaTokenUri   String?
  // Sports milestone customizer fields
  isGoalFrenzy      Boolean      @default(false)
  sportType         String?      // e.g. "Football", "Basketball", "Rugby", "Tennis", "Athletics", "Running", "Motorsport"
  frenzyClub        String?      // e.g. "Arsenal FC", "Los Angeles Lakers"
  frenzyOpponent    String?      // e.g. "Tottenham Hotspur", "Boston Celtics"
  frenzyMinute      String?      // e.g. "89'", "Q4 0.2s"
  frenzyMoment      String?      // e.g. "Last-minute top-corner winner"
  frenzyQuote       String?      // e.g. "Absolute limbs in the North Bank!"
  garmentSize       String?      // "S", "M", "L", "XL", "XXL"
  shippingAddress   Json?        // { recipientName, street, city, state, postalCode, country, phone }
  customerEmail     String?
  customerName      String?
  fulfillmentStatus String       @default("PENDING") // "PENDING", "IN_PRODUCTION", "DISPATCHED"
  trackingNumber    String?
  createdAt         DateTime     @default(now())
}

enum EvidenceCategory {
  SCADA_TELEMETRY
  WATER_TRADE_EFFLUENT_PERMIT
  LAB_GAS_PURITY_CERT
  STAGING_PAYROLL_REGISTER
  CALIBRATION_CERTIFICATE
  OTHER_AUDIT_PROOF
}

model AuditEvidenceDocument {
  id            String            @id @default(cuid())
  licenseeId    String
  licensee      Licensee          @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  reportId      String?
  report        AuditInspectionReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  matrixRowId   String?
  fileName      String
  category      EvidenceCategory
  fileUrl       String
  fileSizeBytes Int
  mimeType      String
  sha256Hash    String
  uploadedBy    String
  createdAt     DateTime          @default(now())

  workflowAnswers WorkflowAnswer[]

  @@index([licenseeId, category])
  @@index([reportId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SOUVENIR ORDERS: Amazon/Jumia-style public order tracking
// ─────────────────────────────────────────────────────────────────────────────

enum SouvenirOrderStatus {
  ORDER_PLACED
  SPLIT_DISBURSED
  QUEUED_FOR_PRINT
  IN_PRODUCTION
  QUALITY_INSPECTED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum SouvenirEventCategory {
  SPORTS
  GALA
  TECH_SUMMIT
  WEDDING
}

model SouvenirOrder {
  id                String                @id @default(cuid())
  orderNumber       String                @unique // e.g. "GHG-ORD-2026-X8F9K"
  customerEmail     String
  customerName      String?
  eventCategory     SouvenirEventCategory
  eventName         String                // e.g. "Arsenal FC Community Day 2026"
  logoDropCount     Int                   // 10, 25, 50, 100, 250, 500
  itemType          String                @default("GHG_LOGO_DROP") // always GHG verified mark
  shippingAddress   Json?                 // { street, city, country, postalCode }
  status            SouvenirOrderStatus   @default(ORDER_PLACED)
  courierName       String?               // "DHL Express", "FedEx"
  trackingNumber    String?
  trackingUrl       String?
  estimatedDelivery DateTime?
  stripeSessionId   String?
  grossAmountCents  Int
  licensorCents     Int                   // 85%
  charityCents      Int                   // 15%
  transactionId     String?               @unique
  transaction       Transaction?          @relation(fields: [transactionId], references: [id])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([customerEmail])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// CHARITY APPLICATIONS: Legal intake, capacity-gated to max 3 active charities
// ─────────────────────────────────────────────────────────────────────────────

enum CharityFocusPillar {
  REFORESTATION_AND_LAND
  OCEAN_AND_WATER
  COMMUNITY_AND_YOUTH
}

enum CharityApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
}

model CharityApplication {
  id                        String                   @id @default(cuid())
  legalEntityName           String
  registrationNumber        String                   // e.g. UK Charity Commission No., US EIN
  registrationJurisdiction  String                   // e.g. "England & Wales", "United States"
  headquartersAddress       String
  focusPillar               CharityFocusPillar
  primaryContactName        String
  primaryContactEmail       String
  stripeConnectedAccountId  String?                  // For direct Stripe disbursements
  annualFinancialStatementUrl String?                // PDF upload URL
  impactMetricDescription   String                   // e.g. "12,000 trees planted per £10,000"
  authorizedSignatoryName   String
  authorizedSignatoryTitle  String
  agreedToTerms             Boolean                  @default(false)
  applicationStatus         CharityApplicationStatus @default(PENDING_REVIEW)
  reviewNotes               String?
  reviewedAt                DateTime?
  createdAt                 DateTime                 @default(now())

  @@index([applicationStatus])
  @@index([primaryContactEmail])
}

// ─────────────────────────────────────────────────────────────────────────────
// ISO AUDIT-READINESS WORKFLOW: Questionnaire persistence and payment state
// ─────────────────────────────────────────────────────────────────────────────

enum IsoReadinessStatus {
  SUBMITTED
  UNDER_REVIEW
  AUDIT_READY
  APPROVED
  REVISION_REQUIRED
}

model IsoReadinessSubmission {
  id                 String               @id @default(cuid())
  licenseeId         String
  licensee           Licensee             @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  standardFramework  String               @default("ISO_14001_50001_19011_2026")
  selectedFrameworks String[]             @default([])
  /// Structured JSON array of { questionId, questionText, answer, isoClause }
  answers            Json
  /// 0–100 calculated conformance score; set by admin reviewer or AI on review
  complianceScore    Int?
  status             IsoReadinessStatus   @default(SUBMITTED)
  reviewerNotes      String?
  paidAt             DateTime?
  auditReadyAt       DateTime?
  stripeSessionId    String?
  tierSelected       String?              // "TIER_1_READINESS" | "TIER_2_CONTINUOUS"
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  credential         AuditWarrantyCredential?

  @@index([licenseeId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT WARRANTY CREDENTIAL: ERC-1155 token lifecycle on Polygon PoS
// ─────────────────────────────────────────────────────────────────────────────

enum CredentialStatus {
  PENDING
  COMPOSITED
  MINTED
  REVOKED
}

model AuditWarrantyCredential {
  id                  String             @id @default(cuid())
  licenseeId          String
  licensee            Licensee           @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  submissionId        String             @unique
  submission          IsoReadinessSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// Client's attestation message, up to 200 characters, embedded in the badge
  clientMessage       String
  clientLogoUrl       String
  compositeBadgeUrl   String?
  selectedFrameworks  String[]           @default([])
  operationalHealth   String             @default("ACTIVE")
  allowedOrigins      String[]           @default([])
  /// Polygon PoS ERC-1155 token ID (numeric string)
  tokenId             String?
  contractAddress     String?
  transactionHash     String?
  openSeaUrl          String?
  /// 1 year from issuance
  warrantyExpiresAt   DateTime?
  /// SHA-256 of (licenseeId + clientMessage + compositeBadgeUrl + issuedAt)
  verificationSeal    String?
  status              CredentialStatus   @default(PENDING)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([licenseeId, status])
}

model DemoBooking {
  id            String   @id @default(cuid())
  fullName      String
  workEmail     String
  companyName   String
  facilityCount String?
  primaryScope  String   @default("CARBON_EMISSION") // CARBON_EMISSION | JOB_REPORTING | DUAL_SCOPE | WEATHER_RESILIENCE
  requestedSlot DateTime
  meetUrl       String?
  ndaRequested  Boolean  @default(true)
  bookingMethod String   @default("FORM") // FORM | GOOGLE_CALENDAR | MICROSOFT_365
  status        String   @default("CONFIRMED") // CONFIRMED | COMPLETED | CANCELLED
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workEmail])
  @@index([requestedSlot])
}

// ─────────────────────────────────────────────────────────────────────────────
// WORKFLOW ENGINE: Parameterized Carbon & Job Reporting Compliance State Machine
// ─────────────────────────────────────────────────────────────────────────────

enum WorkflowType {
  CARBON
  JOB
}

enum WorkflowStatus {
  DRAFT
  SUBMITTED
  AI_SCREENED  // AI Assurance Agent has evaluated and produced clause findings; awaiting Lead Auditor
  UNDER_REVIEW // Lead Auditor is conducting manual review of AI findings
  APPROVED
  REJECTED
  PAID
  BADGE_ISSUED
  MINTED
}

enum WorkflowAnswerType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

enum ReviewOverallDecision {
  APPROVED
  REJECTED
}

model WorkflowFramework {
  id            String              @id
  workflowType  WorkflowType
  code          String              @unique
  name          String
  governingBody String?
  jurisdiction  String?
  description   String?
  createdAt     DateTime            @default(now())

  questions     WorkflowQuestion[]
  submissions   WorkflowSubmission[]

  @@index([workflowType])
}

model WorkflowQuestion {
  id                 String              @id @default(cuid())
  frameworkId        String
  framework          WorkflowFramework   @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  orderIndex         Int
  text               String
  answerType         WorkflowAnswerType  @default(TEXT)
  options            String[]            @default([])
  evidenceRequired   Boolean             @default(false)
  isoClauseReference String
  guidanceNotes      String?
  createdAt          DateTime            @default(now())

  answers            WorkflowAnswer[]

  @@index([frameworkId, orderIndex])
}

model WorkflowSubmission {
  id              String                  @id @default(cuid())
  licenseeId      String
  licensee        Licensee                @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  workflowType    WorkflowType
  frameworkId     String
  framework       WorkflowFramework       @relation(fields: [frameworkId], references: [id])
  status          WorkflowStatus          @default(DRAFT)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewerId      String?
  complianceScore Int?
  paidAt          DateTime?
  stripeSessionId String?
  clientMessage   String?
  clientLogoUrl   String?
  compositeBadgeUrl String?
  tokenId         String?
  contractAddress String?
  transactionHash String?
  openSeaUrl      String?
  mintedAt        DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  answers         WorkflowAnswer[]
  reviewDecision  WorkflowReviewDecision?
  transitions     WorkflowTransitionLog[]

  @@index([licenseeId, status])
  @@index([workflowType, status])
}

model WorkflowAnswer {
  id                 String                 @id @default(cuid())
  submissionId       String
  submission         WorkflowSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId         String
  question           WorkflowQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value              String
  evidenceDocumentId String?
  evidenceDocument   AuditEvidenceDocument? @relation(fields: [evidenceDocumentId], references: [id])
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([submissionId, questionId])
  @@index([submissionId])
}

model WorkflowReviewDecision {
  id                   String                 @id @default(cuid())
  submissionId         String                 @unique
  submission           WorkflowSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId           String?
  overallDecision      ReviewOverallDecision
  overallScore         Int
  perQuestionDecisions Json
  reviewerNotes        String?
  createdAt            DateTime               @default(now())
}

model WorkflowTransitionLog {
  id             String             @id @default(cuid())
  submissionId   String
  submission     WorkflowSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  previousStatus WorkflowStatus?
  newStatus      WorkflowStatus
  triggeredBy    String
  triggerReason  String?
  timestamp      DateTime           @default(now())

  @@index([submissionId, timestamp])
}


model WorkflowApiKey {
  id           String       @id @default(cuid())
  licenseeId   String
  licensee     Licensee     @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  workflowType WorkflowType
  keyHash      String       @unique
  maskedKey    String
  name         String?
  createdAt    DateTime     @default(now())
  revokedAt    DateTime?

  @@index([licenseeId, workflowType])
}

// ─────────────────────────────────────────────────────────────────────────────
// MERCH ENQUIRY: "Contact for Order" submissions from the merchandise store
// ─────────────────────────────────────────────────────────────────────────────

model MerchEnquiry {
  id            String   @id @default(cuid())
  itemId        String   // e.g. "item_nfty_volcano_hoodie"
  itemTitle     String
  contactName   String
  contactEmail  String
  message       String?
  status        String   @default("PENDING") // PENDING | RESPONDED | CLOSED
  adminNotes    String?
  ipAddress     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([contactEmail])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PARTNER NETWORK: Fulfillment studio applications and charity org applications
// ─────────────────────────────────────────────────────────────────────────────

model FulfillmentPartnerApplication {
  id                   String                   @id @default(cuid())
  companyName          String
  workEmail            String
  countryCode          String
  regionOfOperation    String
  capabilities         String[]                 // EMBROIDERY, SCREEN_PRINT, CUT_SEW, WAREHOUSING
  monthlyCapacityUnits String                   // UNDER_500 | 500_2000 | 2000_10000 | OVER_10000
  certifications       String[]                 // GOTS, OEKO_TEX, B_CORP, ISO_14001, NONE
  message              String?
  status               FulfillmentPartnerStatus @default(PENDING)
  reviewedAt           DateTime?
  reviewNotes          String?
  ipAddress            String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status])
  @@index([countryCode])
  @@index([createdAt])
}

enum FulfillmentPartnerStatus {
  PENDING
  UNDER_REVIEW
  CALL_SCHEDULED
  APPROVED
  REJECTED
}

model CharityPartnerApplication {
  id                 String                  @id @default(cuid())
  orgName            String
  workEmail          String
  countryCode        String
  registrationNumber String?
  orgType            String                  // REGISTERED_CHARITY | NGO | TRUST | FOUNDATION | COMMUNITY_FUND
  focusAreas         String[]                // REFORESTATION, EXTREME_WEATHER_RELIEF, OCEAN, BIODIVERSITY, COMMUNITY
  annualReportUrl    String?
  website            String?
  message            String?
  status             CharityPartnerStatus    @default(PENDING)
  reviewedAt         DateTime?
  reviewNotes        String?
  ipAddress          String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([status])
  @@index([countryCode])
  @@index([createdAt])
}

enum CharityPartnerStatus {
  PENDING
  UNDER_REVIEW
  APPROVED_PENDING_ONBOARDING
  APPROVED_ACTIVE
  REJECTED
}

