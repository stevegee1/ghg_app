datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Licensee {
  id                       String          @id @default(cuid())
  name                     String
  vertical                 Vertical
  stripeConnectedAccountId String?
  royaltyBps               Int             @default(1500)
  pricePerDropCents        Int?
  b2bApiKeyHash            String?
  isPubliclyVisible        Boolean         @default(false)
  // Onboarding & Assessment Fields
  logoUrl                  String? // Client company logo URL
  websiteUrl               String? // Client company website
  companyRegistrationNo    String? // UK Companies House number or equivalent
  organisationCountry      String? // ISO 3166-1 alpha-2 e.g. "GB", "DE", "US"
  industrySector           IndustrySector? // Set during onboarding
  hasCompletedAssessment   Boolean         @default(false)

  entitlements ServiceEntitlement[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  transactions             Transaction[]
  portalUsers              PortalUser[]
  splitConfigs             SplitConfigHistory[]
  jobReports               JobCreationReport[]
  calibrationRecords       AssetCalibrationRecord[]
  telemetryLogs            TelemetryLog[]
  nonConformanceEvents     NonConformanceEvent[]
  auditReports             AuditInspectionReport[]
  evidenceDocuments        AuditEvidenceDocument[]
  isoReadinessSubmissions  IsoReadinessSubmission[]
  auditWarrantyCredentials AuditWarrantyCredential[]
  workflowSubmissions      WorkflowSubmission[]
  workflowApiKeys          WorkflowApiKey[]
  clientAssessments        ClientAssessment[]
  fleetAssets              FleetAsset[]
  fleetReadings            FleetReading[]
  fleetImportBatches       FleetImportBatch[]
  fleetSnapshots           FleetTelemetrySnapshot[]
  fleetFaultCodes          FleetFaultCode[]
  fleetApiKeys             FleetApiKey[]
  fleetSetupRequests       FleetSetupRequest[]
  fleetDeviceBindings      FleetDeviceBinding[]
  fleetSubscription        FleetSubscription?
  routingEvents            ServiceRoutingEvent[]
}

enum Vertical {
  B2B_CLEAN_TECH
  B2B_HEAVY_MANUFACTURING
  B2C_SPORTS_MERCH
  B2C_LIFESTYLE_EVENTS
}

model Transaction {
  id                    String            @id @default(cuid())
  licenseeId            String
  licensee              Licensee          @relation(fields: [licenseeId], references: [id])
  checkoutReferenceId   String?           @unique
  grossAmountCents      Int
  currency              String            @default("GBP")
  status                TransactionStatus @default(PENDING)
  stripePaymentIntentId String?
  createdAt             DateTime          @default(now())

  triggerEvent       TriggerEvent?
  financialSplit     FinancialSplit?
  telemetryLog       TelemetryLog?
  customKeepsakeSpec CustomKeepsakeSpec?
  souvenirOrder      SouvenirOrder?

  @@index([licenseeId])
}

enum TransactionStatus {
  PENDING
  SETTLED
  REFUNDED
  REVERSED
  FAILED
}

model TriggerEvent {
  id                 String             @id @default(cuid())
  transactionId      String             @unique
  transaction        Transaction        @relation(fields: [transactionId], references: [id])
  /// Describes data provenance (where a claim originated), NOT whether the claim has been independently verified.
  verificationSource VerificationSource
  attestationNote    String?
  deliveryType       DeliveryType
  fulfillmentStatus  FulfillmentStatus?
  weatherCondition   String?
  eventType          String?
  policyMilestoneRef String?
  rawPayload         Json?
  createdAt          DateTime           @default(now())
}

/// Describes the provenance of claim data submitted to the platform.
/// Note: These values indicate where data originated, NOT whether the underlying environmental/emissions claim has been independently audited or verified.
enum VerificationSource {
  THIRD_PARTY_API
  MANUAL_ATTESTATION
  CONSUMER_OPT_IN
}

enum DeliveryType {
  DIGITAL
  PHYSICAL
}

enum FulfillmentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum CharityStatus {
  PENDING_APPLICATION
  APPROVED_AWAITING_STRIPE
  ACTIVE
  EXPIRED
  PENDING
  INACTIVE
}

model Charity {
  id                       String        @id @default(cuid())
  name                     String
  stripeConnectedAccountId String?
  status                   CharityStatus @default(ACTIVE)
  contractStartDate        DateTime?
  contractEndDate          DateTime?
  registeredCharityNumber  String?
  contactEmail             String?
  statement                String?
  /// Set when the applicant confirms their contact email. Unverified applications are not shown to admins.
  emailVerifiedAt          DateTime?
  emailVerificationHash    String?       @unique
  emailVerificationExpires DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @default(now()) @updatedAt

  allocations CharityAllocation[]
}

model FinancialSplit {
  id                     String      @id @default(cuid())
  transactionId          String      @unique
  transaction            Transaction @relation(fields: [transactionId], references: [id])
  licensorRoyaltyCents   Int
  charityGiftCents       Int
  stripeTransferId       String?
  charityStripeAccountId String?
  allocationsFinalized   Boolean     @default(false)
  settledAt              DateTime?
  createdAt              DateTime    @default(now())

  charityAllocations CharityAllocation[]
}

model CharityAllocation {
  id               String         @id @default(cuid())
  financialSplitId String
  financialSplit   FinancialSplit @relation(fields: [financialSplitId], references: [id], onDelete: Cascade)
  charityId        String
  charity          Charity        @relation(fields: [charityId], references: [id])
  amountCents      Int
  stripeTransferId String?
  transferFailed   Boolean        @default(false)
  retryCount       Int            @default(0)
  createdAt        DateTime       @default(now())

  @@index([financialSplitId])
  @@index([charityId])
}

model PortalUser {
  id                         String      @id @default(cuid())
  email                      String      @unique
  passwordHash               String
  licenseeId                 String?
  licensee                   Licensee?   @relation(fields: [licenseeId], references: [id])
  role                       PortalRole  @default(PARTNER)
  // Profile fields captured at signup
  firstName                  String?
  lastName                   String?
  jobTitle                   String?
  primaryRole                PrimaryRole @default(OTHER)
  // Onboarding state machine
  isOnboardingComplete       Boolean     @default(false)
  onboardingCompletedAt      DateTime?
  // Auth fields
  passwordResetToken         String? // SHA-256 hash of password reset token
  passwordResetExpiresAt     DateTime? // Expiration timestamp for reset token
  emailVerified              Boolean     @default(false)
  emailVerificationToken     String? // SHA-256 hash of email verification token
  emailVerificationExpiresAt DateTime? // Expiration timestamp for verification token
  createdAt                  DateTime    @default(now())

  splitConfigs        SplitConfigHistory[]
  submittedJobReports JobCreationReport[]
  fleetImportBatches  FleetImportBatch[]
  fleetApiKeys        FleetApiKey[]
  fleetSetupRequests  FleetSetupRequest[]
  fleetDataProviders  FleetDataProvider[]
  emissionFactors     EmissionFactor[]

  @@index([licenseeId])
  @@index([passwordResetToken])
  @@index([emailVerificationToken])
}

enum PortalRole {
  PARTNER
  ADMIN
}

// Who the user is in the compliance process
enum PrimaryRole {
  COMPLIANCE_OFFICER // CSO, ESG Director, Sustainability Manager
  FINANCE_DIRECTOR // CFO, Finance Director (emphasise directors' liability)
  OPERATIONS_DIRECTOR // Operations, Facilities, Engineering
  LEGAL_OFFICER // Legal, Compliance & Risk
  SUSTAINABILITY_CONSULTANT // Advising on behalf of a client
  IT_DATA_MANAGER // IT, Data, Digital
  OTHER
}

// Client's industry sector: drives assessment engine framework selection
enum IndustrySector {
  MANUFACTURING
  DATA_CENTRE
  CONSTRUCTION
  LOGISTICS_TRANSPORT
  GREEN_HYDROGEN
  RETAIL_CONSUMER_GOODS
  FINANCIAL_SERVICES
  PUBLIC_SECTOR
  EVENTS_HOSPITALITY
  REAL_ESTATE_PROPERTY
  AGRICULTURE
  OTHER
}

// Organisation headcount band (for SECR / CSRD threshold determination)
enum OrganisationSize {
  MICRO_UNDER_10
  SMALL_10_49
  MEDIUM_50_249
  LARGE_250_PLUS
}

// Revenue band (for SECR / CSRD threshold determination)
enum RevenueBand {
  UNDER_2M
  BAND_2M_10M
  BAND_10M_36M
  BAND_36M_PLUS
}

// Effort estimate shown to client on the compliance recommendation card
enum ComplianceEffort {
  LOW // < 1 week of data gathering
  MEDIUM // 1-4 weeks of data gathering
  HIGH // > 4 weeks, likely requires external support
}

// Per-item status in the preparation checklist
enum ChecklistItemStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  WAIVED // Admin can waive non-mandatory items with a reason
}

// Data type of the checklist item: drives the UI input component
enum ChecklistItemDataType {
  NUMERIC_READING // Enter a number (e.g. kWh, litres, m2)
  DOCUMENT_UPLOAD // Upload a file (PDF, CSV, image)
  DATE_RANGE // Select a from/to date range
  YES_NO // Boolean confirmation
  FREE_TEXT // Short text input
}

model SplitConfigHistory {
  id                   String               @id @default(cuid())
  licenseeId           String?
  licensee             Licensee?            @relation(fields: [licenseeId], references: [id])
  royaltyBps           Int
  charityAllocationBps Json
  isActive             Boolean              @default(true)
  changedByUserId      String
  changedByUser        PortalUser           @relation(fields: [changedByUserId], references: [id])
  changedAt            DateTime             @default(now())
  previousConfigId     String?
  previousConfig       SplitConfigHistory?  @relation("ConfigHistoryChain", fields: [previousConfigId], references: [id])
  nextConfigs          SplitConfigHistory[] @relation("ConfigHistoryChain")

  @@index([licenseeId, isActive])
  @@index([changedByUserId])
}

enum PeriodType {
  QUARTERLY
  ANNUAL
}

enum ReportSource {
  MANUAL_ATTESTATION
  THIRD_PARTY_API
}

model JobCreationReport {
  id                String       @id @default(cuid())
  licenseeId        String
  licensee          Licensee     @relation(fields: [licenseeId], references: [id])
  periodType        PeriodType
  periodStart       DateTime
  periodEnd         DateTime
  jobsCreated       Int
  reportSource      ReportSource
  attestationNote   String
  submittedByUserId String?
  submittedByUser   PortalUser?  @relation(fields: [submittedByUserId], references: [id])
  createdAt         DateTime     @default(now())

  @@unique([licenseeId, periodType, periodStart, periodEnd])
  @@index([licenseeId])
}

enum SensorType {
  ELECTRICITY_SUB_METER
  WATER_FLOW_METER
  GAS_CHROMATOGRAPH
  THERMAL_FLOW_METER
  EMISSIONS_CEMS
}

enum MetricType {
  PUE
  WUE
  MWH_LOAD
  H2_PURITY_PCT
  THERMAL_KW
  CO2_PPM
}

/// GHG Protocol Corporate Standard scope classification (ISO 14064-1:2018 Clause 5.2)
enum GhgScope {
  SCOPE_1 // Direct emissions from owned/controlled sources
  SCOPE_2 // Indirect emissions from purchased energy
  SCOPE_3 // All other indirect value chain emissions
}

model AssetCalibrationRecord {
  id                String     @id @default(cuid())
  licenseeId        String
  licensee          Licensee   @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  assetTag          String // e.g. "PDU-METER-04B", "ELECTROLYSER-SENS-01"
  sensorType        SensorType
  calibrationDate   DateTime
  expiryDate        DateTime
  certDocumentUrl   String // URL/Path to certificate PDF
  certIntegrityHash String // SHA-256 hash of certificate file
  isCurrentlyValid  Boolean    @default(true)
  verifiedBy        String?
  createdAt         DateTime   @default(now())

  telemetryLogs TelemetryLog[]

  @@index([licenseeId, assetTag])
  @@index([expiryDate, isCurrentlyValid])
}

model TelemetryLog {
  id                         String                 @id @default(cuid())
  licenseeId                 String
  licensee                   Licensee               @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  assetCalibrationId         String
  assetCalibration           AssetCalibrationRecord @relation(fields: [assetCalibrationId], references: [id])
  assetTag                   String
  metricType                 MetricType
  numericValue               Float
  rawUnit                    String // e.g. "kW/h", "m3/h", "%", "ppm"
  ghgScope                   GhgScope? // GHG Protocol Scope 1/2/3 classification
  activityAmount             Float? // Activity data quantity (fuel litres, kWh, km etc)
  unitOfMeasure              String? // Activity data unit e.g. "litres", "kWh"
  emissionFactorKgCo2PerUnit Float? // DEFRA/IPCC emission factor applied
  calculatedKgCo2e           Float? // Computed: activityAmount * emissionFactorKgCo2PerUnit
  isWithinBaseline           Boolean                @default(true)
  requiresSupervisor         Boolean                @default(false)
  rawTelemetryJson           Json?
  transactionId              String?                @unique
  transaction                Transaction?           @relation(fields: [transactionId], references: [id])
  createdAt                  DateTime               @default(now())

  @@index([licenseeId, metricType])
  @@index([licenseeId, ghgScope])
  @@index([assetTag, createdAt])
}

enum ConformanceGrade {
  CONFORMANT
  OPPORTUNITY_FOR_IMPROVEMENT
  MINOR_NON_CONFORMANCE
  MAJOR_NON_CONFORMANCE_GREENWASHING_RISK
}

model NonConformanceEvent {
  id                 String           @id @default(cuid())
  licenseeId         String
  licensee           Licensee         @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  isoClause          String // e.g. "ISO 50001:2018 Clause 9.1.1", "ISO 14001:2015 Clause 10.2"
  assetTag           String
  metricName         String // "PUE", "WUE", "H2_PURITY_PCT"
  baselineValue      Float
  observedValue      Float
  percentageVariance Float
  conformanceGrade   ConformanceGrade @default(MINOR_NON_CONFORMANCE)
  rootCauseAnalysis  String?
  correctiveAction   String?
  assignedOwner      String?
  targetClosureDate  DateTime?
  isResolved         Boolean          @default(false)
  resolvedAt         DateTime?
  signOffSupervisor  String?
  createdAt          DateTime         @default(now())

  @@index([licenseeId, isResolved])
  @@index([assetTag, isResolved])
}

enum RiskLevel {
  LOW_RISK_CONFORMANT
  MEDIUM_RISK_OFI
  HIGH_RISK_GREENWASHING_EXPOSURE
}

model AuditInspectionReport {
  id                    String           @id @default(cuid())
  licenseeId            String
  licensee              Licensee         @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  auditRefId            String           @unique // e.g. "AR-2026-DH-01", "SC-2026-AUTO-01"
  facilityType          String // "DATA_CENTRE", "GREEN_HYDROGEN_DRI", "COMMERCIAL_FLEET", "CLEANTECH_HARDWARE", "EVENT_MILESTONE"
  leadAuditorName       String // e.g. "Lead Assurance Officer, GMC, LL.B."
  evaluationDate        DateTime
  weightedScore         Float // 0.0 to 5.0
  overallGrade          ConformanceGrade
  greenwashingRiskLevel RiskLevel
  summaryNotes          String?
  createdAt             DateTime         @default(now())

  matrixRows        AuditMatrixRow[]
  evidenceDocuments AuditEvidenceDocument[]

  @@index([licenseeId, facilityType])
}

model AuditMatrixRow {
  id                        String                @id @default(cuid())
  reportId                  String
  report                    AuditInspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  pillarIndex               Int // 1 to 5
  pillarName                String // e.g. "Power Usage Effectiveness", "Lithium-Ion Battery Integrity"
  isoClauseLink             String // e.g. "ISO 50001:2018 Clause 9.1.1", "ISO 6469-1/-3"
  legalMandate              String // e.g. "UK SECR / Companies Regs 2018", "EU Battery Regulation"
  targetDepartment          String // e.g. "IT Infrastructure", "High-Voltage Engineering"
  questionText              String
  objectiveEvidenceTypes    String // e.g. "SCADA Logs, Sub-Meter Calibration Certs"
  auditorFindings           String?
  scorePoints               Float // 0.0 to 5.0 points
  complianceGrading         ConformanceGrade
  weight                    Float // e.g. 0.25, 0.20, 0.15
  rootCause                 String?
  mandatoryCorrectiveAction String?
  assignedOwner             String?
  targetClosureDate         DateTime?
  verifiedBy                String?
  verificationDate          DateTime?
  createdAt                 DateTime              @default(now())

  @@index([reportId, pillarIndex])
}

model CustomKeepsakeSpec {
  id                String      @id @default(cuid())
  transactionId     String      @unique
  transaction       Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  garmentModel      String // "HEAVYWEIGHT_HOODIE", "STRUCTURED_CAP", "SOFTSHELL_VEST"
  inscribedText     String // e.g. "Bukayo Saka 89' Top-Corner Derby Winner"
  threadColor       String // "GOLD_METALLIC", "STERLING_SILVER", "EMERALD_GREEN"
  placement         String // "LEFT_CHEST", "RIGHT_SLEEVE", "BACK_COLLAR"
  artisanLaborHours Float       @default(1.5)
  lcaCarbonGrams    Int         @default(450)
  // Sports milestone customizer fields
  isGoalFrenzy      Boolean     @default(false)
  sportType         String? // e.g. "Football", "Basketball", "Rugby", "Tennis", "Athletics", "Running", "Motorsport"
  frenzyClub        String? // e.g. "Arsenal FC", "Los Angeles Lakers"
  frenzyOpponent    String? // e.g. "Tottenham Hotspur", "Boston Celtics"
  frenzyMinute      String? // e.g. "89'", "Q4 0.2s"
  frenzyMoment      String? // e.g. "Last-minute top-corner winner"
  frenzyQuote       String? // e.g. "Absolute limbs in the North Bank!"
  garmentSize       String? // "S", "M", "L", "XL", "XXL"
  shippingAddress   Json? // { recipientName, street, city, state, postalCode, country, phone }
  customerEmail     String?
  customerName      String?
  fulfillmentStatus String      @default("PENDING") // "PENDING", "IN_PRODUCTION", "DISPATCHED"
  trackingNumber    String?
  createdAt         DateTime    @default(now())
}

enum EvidenceCategory {
  SCADA_TELEMETRY
  WATER_TRADE_EFFLUENT_PERMIT
  LAB_GAS_PURITY_CERT
  STAGING_PAYROLL_REGISTER
  CALIBRATION_CERTIFICATE
  OTHER_AUDIT_PROOF
}

model AuditEvidenceDocument {
  id            String                 @id @default(cuid())
  licenseeId    String
  licensee      Licensee               @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  reportId      String?
  report        AuditInspectionReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  matrixRowId   String?
  fileName      String
  category      EvidenceCategory
  /// Authenticated download path for the stored file
  fileUrl       String
  /// Location of the file in private storage (FILE_STORAGE_DIR); null for records with no stored file
  storageKey    String?
  fileSizeBytes Int
  mimeType      String
  sha256Hash    String
  uploadedBy    String
  createdAt     DateTime               @default(now())

  workflowAnswers WorkflowAnswer[]

  @@index([licenseeId, category])
  @@index([reportId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SOUVENIR ORDERS: Amazon/Jumia-style public order tracking
// ─────────────────────────────────────────────────────────────────────────────

enum SouvenirOrderStatus {
  ORDER_PLACED
  SPLIT_DISBURSED
  QUEUED_FOR_PRINT
  IN_PRODUCTION
  QUALITY_INSPECTED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum SouvenirEventCategory {
  SPORTS
  GALA
  TECH_SUMMIT
  WEDDING
}

model SouvenirOrder {
  id                String                @id @default(cuid())
  orderNumber       String                @unique // e.g. "GHG-ORD-2026-X8F9K"
  customerEmail     String
  customerName      String?
  eventCategory     SouvenirEventCategory
  eventName         String // e.g. "Arsenal FC Community Day 2026"
  logoDropCount     Int // 10, 25, 50, 100, 250, 500
  itemType          String                @default("GHG_LOGO_DROP") // always GHG verified mark
  shippingAddress   Json? // { street, city, country, postalCode }
  status            SouvenirOrderStatus   @default(ORDER_PLACED)
  courierName       String? // "DHL Express", "FedEx"
  trackingNumber    String?
  trackingUrl       String?
  estimatedDelivery DateTime?
  stripeSessionId   String?
  grossAmountCents  Int
  licensorCents     Int // 85%
  charityCents      Int // 15%
  transactionId     String?               @unique
  transaction       Transaction?          @relation(fields: [transactionId], references: [id])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([customerEmail])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// CHARITY APPLICATIONS: Legal intake, capacity-gated to max 3 active charities
// ─────────────────────────────────────────────────────────────────────────────

enum CharityFocusPillar {
  REFORESTATION_AND_LAND
  OCEAN_AND_WATER
  COMMUNITY_AND_YOUTH
}

enum CharityApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
}

model CharityApplication {
  id                          String                   @id @default(cuid())
  legalEntityName             String
  registrationNumber          String // e.g. UK Charity Commission No., US EIN
  registrationJurisdiction    String // e.g. "England & Wales", "United States"
  headquartersAddress         String
  focusPillar                 CharityFocusPillar
  primaryContactName          String
  primaryContactEmail         String
  stripeConnectedAccountId    String? // For direct Stripe disbursements
  annualFinancialStatementUrl String? // PDF upload URL
  impactMetricDescription     String // e.g. "12,000 trees planted per £10,000"
  authorizedSignatoryName     String
  authorizedSignatoryTitle    String
  agreedToTerms               Boolean                  @default(false)
  applicationStatus           CharityApplicationStatus @default(PENDING_REVIEW)
  reviewNotes                 String?
  reviewedAt                  DateTime?
  createdAt                   DateTime                 @default(now())

  @@index([applicationStatus])
  @@index([primaryContactEmail])
}

// ─────────────────────────────────────────────────────────────────────────────
// ISO AUDIT-READINESS WORKFLOW: Questionnaire persistence and payment state
// ─────────────────────────────────────────────────────────────────────────────

enum IsoReadinessStatus {
  SUBMITTED
  UNDER_REVIEW
  AUDIT_READY
  APPROVED
  REVISION_REQUIRED
}

model IsoReadinessSubmission {
  id                 String             @id @default(cuid())
  licenseeId         String
  licensee           Licensee           @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  standardFramework  String             @default("ISO_14001_50001_19011_2026")
  selectedFrameworks String[]           @default([])
  /// Structured JSON array of { questionId, questionText, answer, isoClause }
  answers            Json
  /// 0–100 calculated conformance score; set by admin reviewer or AI on review
  complianceScore    Int?
  status             IsoReadinessStatus @default(SUBMITTED)
  reviewerNotes      String?
  paidAt             DateTime?
  auditReadyAt       DateTime?
  stripeSessionId    String?
  tierSelected       String? // "TIER_1_READINESS" | "TIER_2_CONTINUOUS"
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  credential AuditWarrantyCredential?

  @@index([licenseeId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT WARRANTY CREDENTIAL: issued and verified from the platform database
// ─────────────────────────────────────────────────────────────────────────────

enum CredentialStatus {
  PENDING
  COMPOSITED
  ISSUED
  REVOKED
}

model AuditWarrantyCredential {
  id                   String                  @id @default(cuid())
  licenseeId           String
  licensee             Licensee                @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  /// Legacy ISO readiness submission (retired pipeline). Exactly one submission link is set.
  submissionId         String?                 @unique
  submission           IsoReadinessSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// Workflow engine submission (GHG and Workforce pipelines)
  workflowSubmissionId String?                 @unique
  workflowSubmission   WorkflowSubmission?     @relation(fields: [workflowSubmissionId], references: [id], onDelete: Cascade)
  /// Client's attestation message, up to 200 characters, embedded in the badge
  clientMessage        String
  clientLogoUrl        String
  compositeBadgeUrl    String?
  selectedFrameworks   String[]                @default([])
  operationalHealth    String                  @default("ACTIVE")
  allowedOrigins       String[]                @default([])
  /// 1 year from issuance
  warrantyExpiresAt    DateTime?
  /// SHA-256 of (licenseeId + clientMessage + compositeBadgeUrl + issuedAt)
  verificationSeal     String?
  status               CredentialStatus        @default(PENDING)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([licenseeId, status])
}

model DemoBooking {
  id            String   @id @default(cuid())
  fullName      String
  workEmail     String
  companyName   String
  facilityCount String?
  primaryScope  String   @default("CARBON_EMISSION") // CARBON_EMISSION | JOB_REPORTING | DUAL_SCOPE | WEATHER_RESILIENCE
  requestedSlot DateTime
  meetUrl       String?
  ndaRequested  Boolean  @default(true)
  bookingMethod String   @default("FORM") // FORM | GOOGLE_CALENDAR | MICROSOFT_365
  status        String   @default("CONFIRMED") // CONFIRMED | COMPLETED | CANCELLED
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([workEmail])
  @@index([requestedSlot])
}

// ─────────────────────────────────────────────────────────────────────────────
// WORKFLOW ENGINE: Parameterized Carbon & Job Reporting Compliance State Machine
// ─────────────────────────────────────────────────────────────────────────────

/// The four separately-gated compliance service lines.
/// GHG  = measure and disclose (SECR, ISO 14064-1, ESOS)
/// CARBON = commit, reduce and claim (PPN 006, SBTi, ISO 14068-1, CMA)
/// JOB  = employment, skills and social value reporting (S106, PPN 002/026, GPG, MSA)
/// MERCH = merchandise sales with product footprint and charity split
enum ServiceLine {
  GHG
  CARBON
  JOB
  MERCH
  FLEET
}

/// Alias used on WorkflowFramework and WorkflowSubmission.
/// CARBON covers both GHG and CARBON service lines at the framework level;
/// use ServiceLine for client-facing pipeline routing.
enum WorkflowType {
  GHG
  CARBON
  JOB
}

enum WorkflowStatus {
  ASSESSMENT_PENDING // Client has not completed the intake assessment yet
  PREPARATION // Client is gathering data per their PreparationChecklist
  DRAFT
  SUBMITTED
  AI_SCREENED // AI Assurance Agent has evaluated and produced clause findings; awaiting Lead Auditor
  UNDER_REVIEW // Lead Auditor is conducting manual review of AI findings
  APPROVED
  REJECTED
  PAID
  BADGE_ISSUED
}

enum WorkflowAnswerType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

enum ReviewOverallDecision {
  APPROVED
  REJECTED
}

model WorkflowFramework {
  id            String       @id
  workflowType  WorkflowType
  code          String       @unique
  name          String
  governingBody String?
  jurisdiction  String?
  description   String?
  /// Set when a framework is withdrawn; retired frameworks cannot start new submissions
  retiredAt     DateTime?
  createdAt     DateTime     @default(now())

  questions   WorkflowQuestion[]
  submissions WorkflowSubmission[]
  versions    WorkflowFrameworkVersion[]

  @@index([workflowType])
}

/// One published edition of a compliance standard. Published versions are never edited: a change
/// to the standard is a new version with new questions, so every submission keeps the exact
/// questions it was assessed against.
model WorkflowFrameworkVersion {
  id                String            @id
  frameworkId       String
  framework         WorkflowFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  /// Our version label, e.g. "2026.1"
  version           String
  /// The edition of the external standard this version reflects
  standardReference String
  effectiveFrom     DateTime
  changeSummary     String?
  /// SHA-256 of the canonical question set, sealed by the framework seed
  contentHash       String?
  publishedAt       DateTime          @default(now())
  /// Retired versions cannot start new submissions; existing submissions keep them
  retiredAt         DateTime?
  createdAt         DateTime          @default(now())

  questions   WorkflowQuestion[]
  submissions WorkflowSubmission[]

  @@unique([frameworkId, version])
  @@index([frameworkId, effectiveFrom])
}

model WorkflowQuestion {
  id                 String                   @id @default(cuid())
  frameworkId        String
  framework          WorkflowFramework        @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  versionId          String
  version            WorkflowFrameworkVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  orderIndex         Int
  text               String
  answerType         WorkflowAnswerType       @default(TEXT)
  options            String[]                 @default([])
  evidenceRequired   Boolean                  @default(false)
  isoClauseReference String
  guidanceNotes      String?
  createdAt          DateTime                 @default(now())

  answers WorkflowAnswer[]

  @@index([frameworkId, orderIndex])
  @@index([versionId, orderIndex])
}

model WorkflowSubmission {
  id                 String                   @id @default(cuid())
  licenseeId         String
  licensee           Licensee                 @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  workflowType       WorkflowType
  frameworkId        String
  framework          WorkflowFramework        @relation(fields: [frameworkId], references: [id])
  /// The standard version this submission is assessed against, fixed when the draft is created
  frameworkVersionId String
  frameworkVersion   WorkflowFrameworkVersion @relation(fields: [frameworkVersionId], references: [id])
  status             WorkflowStatus           @default(DRAFT)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewerId         String?
  complianceScore    Int?
  /// AI pre-screen results, kept separate from the Lead Auditor's decision
  aiScreenedAt       DateTime?
  aiReviewer         String?
  aiScore            Int?
  aiRecommendation   String?
  aiSummary          String?
  aiClauseFindings   Json?
  paidAt             DateTime?
  stripeSessionId    String?
  clientMessage      String?
  clientLogoUrl      String?
  compositeBadgeUrl  String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  answers                  WorkflowAnswer[]
  credential               AuditWarrantyCredential?
  reviewDecision           WorkflowReviewDecision?
  transitions              WorkflowTransitionLog[]
  complianceRecommendation ComplianceRecommendation?

  @@index([licenseeId, status])
  @@index([workflowType, status])
  @@index([frameworkVersionId])
}

model WorkflowAnswer {
  id                 String                 @id @default(cuid())
  submissionId       String
  submission         WorkflowSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId         String
  question           WorkflowQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value              String
  evidenceDocumentId String?
  evidenceDocument   AuditEvidenceDocument? @relation(fields: [evidenceDocumentId], references: [id])
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([submissionId, questionId])
  @@index([submissionId])
}

model WorkflowReviewDecision {
  id                    String                @id @default(cuid())
  submissionId          String                @unique
  submission            WorkflowSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId            String?
  /// Lead Auditor identity at sign-off, snapshotted from their account
  reviewerName          String?
  reviewerAccreditation String?
  overallDecision       ReviewOverallDecision
  overallScore          Int
  perQuestionDecisions  Json
  reviewerNotes         String?
  createdAt             DateTime              @default(now())
}

model WorkflowTransitionLog {
  id             String             @id @default(cuid())
  submissionId   String
  submission     WorkflowSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  previousStatus WorkflowStatus?
  newStatus      WorkflowStatus
  triggeredBy    String
  triggerReason  String?
  timestamp      DateTime           @default(now())

  @@index([submissionId, timestamp])
}

model WorkflowApiKey {
  id           String       @id @default(cuid())
  licenseeId   String
  licensee     Licensee     @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  workflowType WorkflowType
  keyHash      String       @unique
  maskedKey    String
  name         String?
  createdAt    DateTime     @default(now())
  revokedAt    DateTime?

  @@index([licenseeId, workflowType])
}

// ─────────────────────────────────────────────────────────────────────────────
// MERCH ENQUIRY: "Contact for Order" submissions from the merchandise store
// ─────────────────────────────────────────────────────────────────────────────

model MerchEnquiry {
  id           String   @id @default(cuid())
  itemId       String // e.g. "item_nfty_volcano_hoodie"
  itemTitle    String
  contactName  String
  contactEmail String
  message      String?
  status       String   @default("PENDING") // PENDING | RESPONDED | CLOSED
  adminNotes   String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([contactEmail])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PARTNER NETWORK: Fulfillment studio applications and charity org applications
// ─────────────────────────────────────────────────────────────────────────────

model FulfillmentPartnerApplication {
  id                   String                   @id @default(cuid())
  companyName          String
  workEmail            String
  countryCode          String
  regionOfOperation    String
  capabilities         String[] // EMBROIDERY, SCREEN_PRINT, CUT_SEW, WAREHOUSING
  monthlyCapacityUnits String // UNDER_500 | 500_2000 | 2000_10000 | OVER_10000
  certifications       String[] // GOTS, OEKO_TEX, B_CORP, ISO_14001, NONE
  message              String?
  status               FulfillmentPartnerStatus @default(PENDING)
  reviewedAt           DateTime?
  reviewNotes          String?
  ipAddress            String?
  /// Set when the applicant confirms their work email. Unverified applications are not shown to admins.
  emailVerifiedAt          DateTime?
  emailVerificationHash    String?                  @unique
  emailVerificationExpires DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status])
  @@index([countryCode])
  @@index([createdAt])
}

enum FulfillmentPartnerStatus {
  PENDING
  UNDER_REVIEW
  CALL_SCHEDULED
  APPROVED
  REJECTED
}

model CharityPartnerApplication {
  id                 String               @id @default(cuid())
  orgName            String
  workEmail          String
  countryCode        String
  registrationNumber String?
  orgType            String // REGISTERED_CHARITY | NGO | TRUST | FOUNDATION | COMMUNITY_FUND
  focusAreas         String[] // REFORESTATION, EXTREME_WEATHER_RELIEF, OCEAN, BIODIVERSITY, COMMUNITY
  annualReportUrl    String?
  website            String?
  message            String?
  status             CharityPartnerStatus @default(PENDING)
  reviewedAt         DateTime?
  reviewNotes        String?
  ipAddress          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status])
  @@index([countryCode])
  @@index([createdAt])
}

enum CharityPartnerStatus {
  PENDING
  UNDER_REVIEW
  APPROVED_PENDING_ONBOARDING
  APPROVED_ACTIVE
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSESSMENT LAYER: The Babysitter Model: hold client hands from zero to 100
// No WorkflowSubmission can be created without a completed ClientAssessment.
// ─────────────────────────────────────────────────────────────────────────────

/// Structured intake questionnaire answered at onboarding.
/// 12 plain-English questions that drive the AssessmentDecisionEngine.
/// The client never sees ISO codes or regulation names during this step.
model ClientAssessment {
  id         String   @id @default(cuid())
  licenseeId String
  licensee   Licensee @relation(fields: [licenseeId], references: [id], onDelete: Cascade)

  // Block A: Who They Are
  organisationCountry String // ISO 3166-1 alpha-2: "GB", "DE", "US"
  organisationSize    OrganisationSize
  annualRevenueBand   RevenueBand
  industrySector      IndustrySector

  // Block B: What They Do
  hasPhysicalSites     Boolean // Own/operate physical buildings or facilities?
  hasProductionProcess Boolean // Manufacture or produce physical goods?
  hasFleet             Boolean // Operate a vehicle fleet?
  hasIoTMeters         Boolean // Smart meters or SCADA systems installed?

  // Block C: Legal Context
  isUKPublicContractor   Boolean // Hold or bid for UK government contracts?
  hasPlanningConsent     Boolean // Planning permission with S106 obligations?
  makesPublicGreenClaims Boolean // Make any environmental claims publicly?
  hasGreenHydrogen       Boolean @default(false) // Produce or operate green hydrogen?

  // Service lines the client selected during intake (drives pipeline routing)
  serviceLinesRequested ServiceLine[] @default([])
  /// Fleet onboarding answers: asset count band, categories and cloud connection status
  fleetProfile          Json?
  /// Set when a newer assessment replaces this one; history is kept, never deleted
  supersededAt          DateTime?

  // Metadata
  assessmentVersion String    @default("v1.0")
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  recommendations ComplianceRecommendation[]

  @@index([licenseeId])
}

/// Platform-generated compliance framework recommendation.
/// One record per applicable framework per assessment.
/// Written in plain English: client sees why it applies and what happens if skipped.
model ComplianceRecommendation {
  id           String           @id @default(cuid())
  assessmentId String
  assessment   ClientAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  licenseeId   String

  // Framework identification
  frameworkCode String // e.g. "UK_SECR", "ISO_14064_1", "UK_SECTION_106"
  frameworkName String // Plain English: "Streamlined Energy & Carbon Reporting"
  workflowType  WorkflowType // CARBON or JOB

  // Why it applies: shown to client in plain English, no ISO codes
  isLegallyMandatory   Boolean // true = statute requires it; false = recommended
  plainEnglishWhy      String // e.g. "You employ more than 250 people in the UK..."
  consequenceIfSkipped String? // e.g. "Directors personally liable; Companies House rejection"
  enforcementBody      String? // e.g. "Financial Reporting Council (FRC)"
  estimatedEffort      ComplianceEffort

  // Client decision
  clientAccepted   Boolean   @default(true) // Locked true for mandatory frameworks
  deferredReason   String?
  clientReviewedAt DateTime?

  displayOrder Int // Order shown to client (mandatory first)
  createdAt    DateTime @default(now())

  checklist            PreparationChecklist?
  workflowSubmission   WorkflowSubmission?   @relation(fields: [workflowSubmissionId], references: [id])
  workflowSubmissionId String?               @unique

  @@index([licenseeId, frameworkCode])
  @@index([assessmentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVICE ENTITLEMENT: Per-licensee, per-service-line access control record.
// A licensee gains access to a pipeline only after an entitlement record exists
// with status ACTIVE. Admin can revoke or suspend without deleting data.
// ─────────────────────────────────────────────────────────────────────────────

enum EntitlementStatus {
  PENDING // Assessment submitted, awaiting admin review
  ACTIVE // Pipeline access granted
  SUSPENDED // Temporarily blocked (payment lapse, non-conformance hold)
  REVOKED // Permanently withdrawn
}

model ServiceEntitlement {
  id           String            @id @default(cuid())
  licenseeId   String
  licensee     Licensee          @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  serviceLine  ServiceLine
  status       EntitlementStatus @default(PENDING)
  grantedAt    DateTime?
  grantedBy    String? // PortalUser.id of the admin who approved
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([licenseeId, serviceLine])
  @@index([licenseeId, status])
  @@index([serviceLine, status])
}

/// Per-framework, per-client preparation checklist.
/// Created by PreparationChecklistService when client accepts a recommendation.
/// isReadyToIngest is set true by the platform when all mandatory items are complete.
model PreparationChecklist {
  id               String                   @id @default(cuid())
  recommendationId String                   @unique
  recommendation   ComplianceRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  licenseeId       String

  totalItems      Int      @default(0)
  completedItems  Int      @default(0)
  isReadyToIngest Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items PreparationChecklistItem[]

  @@index([licenseeId])
}

/// Individual item in a preparation checklist.
/// isoClauseReference is stored in DB and visible in admin view only: never shown to client.
/// plainEnglishLabel and plainEnglishGuidance are what the client sees.
model PreparationChecklistItem {
  id          String               @id @default(cuid())
  checklistId String
  checklist   PreparationChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  itemCode             String // e.g. "ELECTRICITY_BILLS_12M", "PAYROLL_REGISTER"
  plainEnglishLabel    String // e.g. "Electricity bills for the last 12 months"
  plainEnglishGuidance String // e.g. "Ask your energy supplier for an annual usage report..."
  isoClauseReference   String? // ADMIN-ONLY. e.g. "ISO 14064-1:2018 Cl 5.4.3": never shown to client
  dataType             ChecklistItemDataType
  isMandatory          Boolean               @default(true)
  status               ChecklistItemStatus   @default(NOT_STARTED)
  completedAt          DateTime?
  waivedReason         String? // Set by admin when status = WAIVED

  // Links to actual ingested data once the client enters it
  linkedEvidenceDocId String? // FK to AuditEvidenceDocument once uploaded
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([checklistId, status])
  @@index([itemCode])
}

// ─────────────────────────────────────────────────────────────────────────────
// FLEET EMISSIONS SERVICE: Scope 1 mobile combustion from equipment and vehicles
// ─────────────────────────────────────────────────────────────────────────────

enum FleetAssetCategory {
  EXCAVATOR
  DUMPER
  DUMP_TRUCK
  WHEEL_LOADER
  CRANE
  TELEHANDLER
  ROLLER
  GENERATOR
  HGV
  LIGHT_COMMERCIAL_VEHICLE
  CAR
  OTHER
}

/// Ownership decides the GHG Protocol boundary: with operational control, fuel is Scope 1.
enum FleetOwnership {
  OWNED
  LEASED
  RENTED_IN
  RENTED_OUT
}

/// Combustion fuels as categorised in the UK DESNZ conversion factors.
enum FleetFuelType {
  DIESEL_AVERAGE_BIOFUEL_BLEND
  DIESEL_MINERAL
  PETROL_AVERAGE_BIOFUEL_BLEND
  PETROL_MINERAL
  HVO
  LPG
}

enum FleetReadingSource {
  CSV_UPLOAD
  FUEL_CARD
  ISO_15143_3
  PARTNER_API
  /// Telemetry sent by the client through the Fleet API
  CLIENT_API
  /// Branch A: pulled from a manufacturer or telematics cloud
  OEM_CLOUD
  /// Branch B: sent by a tracking device fitted to the machine
  TRACKING_DEVICE
}

/// How an asset's data reaches us, confirmed per asset by the client. Never assumed.
enum FleetConnectionBranch {
  UNCONFIRMED
  /// Branch A: the machine already reports to a manufacturer or telematics cloud
  CLOUD_CONNECTED
  /// Branch B: the machine needs a tracking device fitted
  TRACKING_DEVICE
  /// Fuel cards or CSV uploads only
  MANUAL
}

enum FleetProviderKind {
  /// Branch B: a tracking device that sends its readings to us
  TRACKING_DEVICE
  /// Branch A: a manufacturer or telematics cloud we pull from
  OEM_CLOUD
}

/// How a provider proves who it is. Device kinds push to us; cloud kinds are called by us.
enum FleetProviderAuthType {
  /// The device sends a shared key in a header
  DEVICE_SHARED_KEY
  /// The device signs timestamp + "." + body with HMAC-SHA256 using the shared secret
  DEVICE_HMAC_SHA256
  OAUTH2_CLIENT_CREDENTIALS
  HTTP_BASIC
  API_KEY_HEADER
}

enum FleetSetupRequestStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum FleetSubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
}

/// Published emission factor entered by an administrator from the cited source. Never inferred.
model EmissionFactor {
  id              String        @id @default(cuid())
  source          String
  publicationYear Int
  fuelType        FleetFuelType
  unit            String
  kgCo2ePerUnit   Decimal       @db.Decimal(12, 6)
  citation        String
  createdByUserId String
  createdBy       PortalUser    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now())
  retiredAt       DateTime?

  readings FleetReading[]

  @@unique([source, publicationYear, fuelType])
  @@index([fuelType, publicationYear])
}

model FleetAsset {
  id                      String                @id @default(cuid())
  licenseeId              String
  licensee                Licensee              @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  assetTag                String
  name                    String
  category                FleetAssetCategory
  make                    String?
  model                   String?
  serialNumber            String?
  fuelType                FleetFuelType
  ownership               FleetOwnership
  /// True when the licensee has operational control (GHG Protocol). Fuel then counts as Scope 1.
  operationalControl      Boolean
  siteName                String?
  active                  Boolean               @default(true)
  connectionBranch        FleetConnectionBranch @default(UNCONFIRMED)
  connectionConfirmedAt   DateTime?
  connectionConfirmedById String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  readings  FleetReading[]
  snapshots FleetTelemetrySnapshot[]
  faults    FleetFaultCode[]
  bindings  FleetDeviceBinding[]

  @@unique([licenseeId, assetTag])
  @@index([licenseeId, active])
}

model FleetImportBatch {
  id           String             @id @default(cuid())
  licenseeId   String
  licensee     Licensee           @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  source       FleetReadingSource
  fileName     String
  fileSha256   String
  rowsReceived Int
  rowsAccepted Int
  rowsRejected Int
  /// Rejected rows with line numbers and reasons
  rejections   Json
  uploadedById String
  uploadedBy   PortalUser         @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime           @default(now())

  readings FleetReading[]

  @@index([licenseeId, createdAt])
}

model FleetReading {
  id               String             @id @default(cuid())
  licenseeId       String
  licensee         Licensee           @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  assetId          String
  asset            FleetAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  importBatchId    String?
  importBatch      FleetImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  source           FleetReadingSource
  periodStart      DateTime
  periodEnd        DateTime
  fuelQuantity     Decimal            @db.Decimal(14, 3)
  fuelUnit         String
  engineHours      Decimal?           @db.Decimal(12, 2)
  idleHours        Decimal?           @db.Decimal(12, 2)
  distanceKm       Decimal?           @db.Decimal(14, 2)
  /// Factor applied and its result, fixed at import so later factor updates never rewrite history
  emissionFactorId String
  emissionFactor   EmissionFactor     @relation(fields: [emissionFactorId], references: [id])
  kgCo2e           Decimal            @db.Decimal(16, 3)
  /// Version of the standard data schema the figures were normalised to
  schemaVersionId  String
  schemaVersion    FleetSchemaVersion @relation(fields: [schemaVersionId], references: [id])
  /// For telemetry-derived readings: the two cumulative snapshots the period was calculated from
  startSnapshotId  String?
  endSnapshotId    String?
  createdAt        DateTime           @default(now())

  @@unique([assetId, periodStart, periodEnd, source])
  @@index([licenseeId, periodStart])
}

/// A published version of the standard Fleet data schema (ISO 15143-3 / AEMP 2.0 data elements).
/// Recorded on every snapshot and calculation; a changed field set is a new version.
model FleetSchemaVersion {
  id          String    @id
  standard    String
  version     String
  /// The fields of the version with their units
  fieldSpec   Json
  publishedAt DateTime  @default(now())
  retiredAt   DateTime?

  snapshots FleetTelemetrySnapshot[]
  readings  FleetReading[]
  providers FleetDataProvider[]
}

/// One machine's ISO 15143-3 readings at one moment. Meters are cumulative; fuel used over a
/// period is the difference between consecutive snapshots from the same source.
model FleetTelemetrySnapshot {
  id                       String             @id @default(cuid())
  licenseeId               String
  licensee                 Licensee           @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  assetId                  String
  asset                    FleetAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  schemaVersionId          String
  schemaVersion            FleetSchemaVersion @relation(fields: [schemaVersionId], references: [id])
  source                   FleetReadingSource
  observedAt               DateTime
  cumulativeOperatingHours Decimal?           @db.Decimal(12, 2)
  cumulativeIdleHours      Decimal?           @db.Decimal(12, 2)
  cumulativeFuelUsedLitres Decimal?           @db.Decimal(14, 3)
  fuelRemainingPercent     Decimal?           @db.Decimal(5, 2)
  odometerKm               Decimal?           @db.Decimal(14, 2)
  engineRunning            Boolean?
  /// Location is kept for 90 days, then cleared on all but the latest snapshot per asset
  latitude                 Decimal?           @db.Decimal(9, 6)
  longitude                Decimal?           @db.Decimal(9, 6)
  altitudeM                Decimal?           @db.Decimal(8, 2)
  /// Set when a meter went backwards against the previous snapshot; no period is calculated across it
  counterReset             Boolean            @default(false)
  payloadSha256            String
  receivedAt               DateTime           @default(now())

  faults FleetFaultCode[]

  @@unique([assetId, source, observedAt])
  @@index([licenseeId, observedAt])
  @@index([assetId, source, observedAt])
}

/// A fault or caution code reported by a machine.
model FleetFaultCode {
  id          String                  @id @default(cuid())
  licenseeId  String
  licensee    Licensee                @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  assetId     String
  asset       FleetAsset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  snapshotId  String?
  snapshot    FleetTelemetrySnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  source      FleetReadingSource
  observedAt  DateTime
  code        String
  severity    String?
  description String?
  createdAt   DateTime                @default(now())

  @@unique([assetId, observedAt, code])
  @@index([licenseeId, observedAt])
}

/// A client's key for the Fleet API. Only a SHA-256 of the key is stored; the key is shown once.
model FleetApiKey {
  id          String     @id @default(cuid())
  licenseeId  String
  licensee    Licensee   @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String     @unique
  /// First characters of the key, so clients can tell keys apart
  keyPrefix   String
  scopes      String[]
  createdById String
  createdBy   PortalUser @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([licenseeId, revokedAt])
}

/// A data source configured by an administrator: how it authenticates and how its fields map to
/// the standard schema. New devices and providers are added here, never in code.
model FleetDataProvider {
  id               String                @id @default(cuid())
  name             String                @unique
  kind             FleetProviderKind
  authType         FleetProviderAuthType
  /// Non-secret settings, e.g. header names and timestamp tolerance
  authConfig       Json
  /// The shared secret, encrypted with FLEET_CREDENTIALS_KEY; never returned by the API
  secretCiphertext String?
  /// Where each standard-schema field is found in a message, and its unit
  fieldMapping     Json
  schemaVersionId  String
  schemaVersion    FleetSchemaVersion    @relation(fields: [schemaVersionId], references: [id])
  active           Boolean               @default(true)
  createdById      String
  createdBy        PortalUser            @relation(fields: [createdById], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  bindings FleetDeviceBinding[]
}

/// Links a device's own identifier to a client's asset, made when the tracker is fitted.
model FleetDeviceBinding {
  id               String            @id @default(cuid())
  providerId       String
  provider         FleetDataProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  externalDeviceId String
  licenseeId       String
  licensee         Licensee          @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  assetId          String
  asset            FleetAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  active           Boolean           @default(true)
  /// "providerId:externalDeviceId" while active, null once released, so a device id is bound to
  /// at most one asset at a time and released bindings keep their original id for the record
  activeKey        String?           @unique
  createdById      String
  createdAt        DateTime          @default(now())
  deactivatedAt    DateTime?

  @@index([providerId, externalDeviceId])
  @@index([licenseeId])
  @@index([assetId])
}

/// A client's request for a call to set up tracking devices on Branch B assets.
model FleetSetupRequest {
  id             String                  @id @default(cuid())
  licenseeId     String
  licensee       Licensee                @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    PortalUser              @relation(fields: [requestedById], references: [id])
  /// The tracking-device assets the call is about
  assetIds       String[]
  contactName    String
  contactEmail   String
  contactPhone   String?
  preferredTimes String?
  notes          String?
  status         FleetSetupRequestStatus @default(REQUESTED)
  scheduledFor   DateTime?
  adminNotes     String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([licenseeId, status])
  @@index([status, createdAt])
}

model FleetSubscription {
  id                   String                  @id @default(cuid())
  licenseeId           String                  @unique
  licensee             Licensee                @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  stripeCustomerId     String                  @unique
  stripeSubscriptionId String?                 @unique
  status               FleetSubscriptionStatus @default(INCOMPLETE)
  /// Billed quantity: the number of active assets last synced to Stripe
  quantity             Int                     @default(0)
  currentPeriodEnd     DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// SERVICE ROUTING: every routing decision and pipeline handoff is logged
// ─────────────────────────────────────────────────────────────────────────────

enum RoutingEventType {
  SERVICE_SELECTED
  SERVICE_ADDED
  SERVICE_ACTIVATED
  SERVICE_ACTIVATION_BLOCKED
  SERVICE_SUSPENDED
  HANDOFF_STARTED
  HANDOFF_COMPLETED
  /// A client confirmed how one or more Fleet assets connect (Branch A, Branch B or manual)
  FLEET_ASSET_BRANCH_SET
}

model ServiceRoutingEvent {
  id          String           @id @default(cuid())
  licenseeId  String
  licensee    Licensee         @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  eventType   RoutingEventType
  serviceLine ServiceLine?
  /// PortalUser ID, or a system actor such as STRIPE_SUBSCRIPTION
  actor       String
  /// Why the decision was made, for example the onboarding answers that routed the client
  detail      Json
  createdAt   DateTime         @default(now())

  @@index([licenseeId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// NEWSLETTER: double opt-in subscriptions with a consent record (UK GDPR / PECR)
// ─────────────────────────────────────────────────────────────────────────────

enum NewsletterStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id                   String           @id @default(cuid())
  email                String           @unique
  status               NewsletterStatus @default(PENDING)
  /// The wording the person agreed to, kept with the time they agreed
  consentText          String
  consentAt            DateTime
  /// SHA-256 of the confirmation token; cleared once confirmed
  confirmTokenHash     String?          @unique
  confirmTokenExpires  DateTime?
  /// SHA-256 of the unsubscribe token sent in every email
  unsubscribeTokenHash String           @unique
  confirmedAt          DateTime?
  unsubscribedAt       DateTime?
  source               String           @default("FOOTER")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status])
}

enum MerchProductKind {
  CATALOGUE
  CUSTOM_GARMENT
  EVENT_SOUVENIR
}

/// A merch item and its price. Administrators edit prices; checkout reads them on the server.
/// A null price means the item is sold by enquiry only.
model MerchProduct {
  id                String           @id
  kind              MerchProductKind
  title             String
  description       String?
  category          String?
  imageUrl          String?
  imagePosition     String?
  pricePence        Int?
  supplierCostPence Int?
  lcaGrams          Int?
  laborHours        Float?
  licenseeId        String
  currency          String           @default("GBP")
  active            Boolean          @default(true)
  sortOrder         Int              @default(0)
  updatedByUserId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  @@index([kind, active, sortOrder])
}
